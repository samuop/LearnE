{
  "manifest_version": 3,
  "name": "YT Music Remote",
  "version": "1.0.0",
  "description": "Controlá YouTube Music de tu PC desde el celular.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "YT Music Remote", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
